{
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/LibreChat",
  "forwardPorts": [3080],
  "portsAttributes": {
    "3080": {
      "label": "LibreChat",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": null
        }
      }
    }
  },
  "postCreateCommand": "npm ci --no-audit && npm run frontend",
  "postStartCommand": "npm run backend > /tmp/librechat-backend.log 2>&1 &",
  "remoteUser": "vscode"
}
